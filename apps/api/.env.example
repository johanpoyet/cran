# API (apps/api). Real values live in Dokploy environment variables, never in the repo.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://cran:cran@localhost:5432/cran
LOG_LEVEL=info
APP_VERSION=dev

# Better Auth: public URL of the API and a secret of at least 32 characters (openssl rand -base64 32)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Sign in with Apple and Google (optional until the provider consoles are set up)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=fr.johanpoyet.cran
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# Sentry (optional locally)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
