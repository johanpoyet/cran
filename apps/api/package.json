{
  "name": "@cran/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsdown",
    "start": "node dist/migrate.js && node --import ./dist/instrument.js dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.14",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@scalar/hono-api-reference": "0.12.14",
    "@sentry/node": "11.9.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cran/config": "workspace:*",
    "@cran/shared": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
